{
  "manifest_version": 3,
  "name": "Twitch & Kick Bing Translator",
  "version": "0.1.0",
  "description": "Translate Twitch and Kick chat messages to Persian using Bing Translator.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.bing.com/*","https://cn.bing.com/*","https://www.twitch.tv/*","https://kick.com/*"],
  "background": {"service_worker":"background.js"},
  "content_scripts": [{"matches":["https://www.twitch.tv/*","https://kick.com/*"],"js":["content.js"],"run_at":"document_idle"}],
  "action": {"default_title":"Chat Translator"}
}